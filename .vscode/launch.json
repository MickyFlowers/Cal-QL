{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug_antmaze",
            "type": "debugpy",
            "request": "launch",
            "module": "JaxCQL.conservative_sac_main",
            "console": "integratedTerminal",
            "env": {
                "LD_LIBRARY_PATH": "${env:LD_LIBRARY_PATH}:/root/.mujoco/mujoco210/bin",
                "D4RL_SUPPRESS_IMPORT_ERROR": "1",
                "CUDA_VISIBLE_DEVICES": "0",
                "XLA_PYTHON_CLIENT_PREALLOCATE": "false"
            },
            "args": [
                "--env=antmaze-medium-diverse-v2",
                "--logging.online",
                "--seed=0",
                "--logging.project=test",
                "--cql_min_q_weight=5.0",
                "--cql.cql_target_action_gap=0.8",
                "--cql.cql_lagrange=True",
                "--policy_arch=256-256",
                "--qf_arch=256-256-256-256",
                "--offline_eval_every_n_epoch=50",
                "--online_eval_every_n_env_steps=2000",
                "--eval_n_trajs=20",
                "--n_train_step_per_epoch_offline=1000",
                "--n_pretrain_epochs=1000",
                "--max_online_env_steps=1e6",
                "--mixing_ratio=0.5",
                "--reward_scale=10.0",
                "--reward_bias=-5",
                "--enable_calql=True"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "debug_bc",
            "type": "debugpy",
            "request": "launch",
            "module": "bc.train_bc",
            "console": "integratedTerminal",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "XLA_PYTHON_CLIENT_PREALLOCATE": "false"
            },
            "args": [
                "logging.online=true",
                "logging.prefix=bc",
                "seed=0",
                "logging.project=screwdriver-il",
                "policy_obs_head_arch=256-256",
                "policy_hidden_dim=256",
                "policy_out_head_arch=256-256",
                "batch_size=64",
                "trainer.learning_rate=3e-4",
                "data_root=/mnt/pfs/dataset/screwdriver-il-converted",
                "n_train_epochs=1000",
                "save_model=True",
                "save_ckpt_dir=/root/workspace/Cal-QL/checkpoints/",
                "save_model_interval=2",
                // "load_ckpt_dir=/root/workspace/Cal-QL/checkpoints/bc--screwdriver-il/20251105-101205"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "debug_rollout",
            "type": "debugpy",
            "request": "launch",
            "module": "bc.rollout",
            "console": "integratedTerminal",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "XLA_PYTHON_CLIENT_PREALLOCATE": "false"
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}